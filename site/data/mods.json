  "mods": [
    {
      "id": "inventory-pickup",
      "slug": "inventory-pickup",
      "name": "Inventory Pickup",
      "category": "hud",
      "status": "planned",
      "featured": true,
      "icon": "inventory",
      "accent": "lime",
      "summary": {
        "az": "Yerdən və sandıqdan götürdüyün əşyaları ikon, inventar sayı və +artım ilə göstərən tənzimlənən HUD bildirişi.",
        "en": "A customizable HUD that shows item icons, inventory totals and +gains when you pick up or transfer items."
      },
      "description": {
        "az": "Inventory Pickup modunun məqsədi əşya yerdən götürüldükdə və ya sandıqdan inventara köçürüldükdə ekranda yığcam bildiriş göstərməkdir. Bildirişdə əşyanın ikonu, adı, yeni ümumi sayı və artım miqdarı əks olunacaq. Ekrandakı mövqe və görünmə müddəti tənzimlənə biləcək. Hazırda konsept mərhələsindədir: işlək mod və .jar faylı yoxdur.",
        "en": "Inventory Pickup is planned to show a compact notification when you collect a dropped item or transfer it from a chest. Each notification will contain the item icon, name, new total inventory count and the amount gained. Position and display duration will be customizable. This is a concept: no working mod or .jar file exists yet."
      },
      "minecraftVersions": [
        "1.21.10"
      ],
      "loaders": [
        "Fabric"
      ],
