{
  "name": "zovrax",
  "version": "2.0.0",
  "private": true,
  "description": "Zovrax: independent Minecraft Java Edition mod and shaderpack catalog, deployed to GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cd .. && node .github/scripts/build-catalog.mjs",
    "validate": "cd .. && node .github/scripts/build-catalog.mjs && node .github/scripts/validate-catalog.mjs",
    "test": "node --test",
    "check": "npm run validate && npm test",
    "start": "node scripts/serve.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
